# ============================================
# Secure Remote Tracking System — Environment
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit real secrets to version control.

# HMAC secret key for payload validation (min 64 chars)
EXPO_PUBLIC_HMAC_SECRET=your-hmac-secret-key-minimum-64-characters-for-production-security

# Backend API base URL
EXPO_PUBLIC_API_BASE_URL=https://api.yourserver.com

# Emergency SMS contact number (E.164 format)
EXPO_PUBLIC_EMERGENCY_SMS=+1234567890

# AES-256 encryption key for HTTPS payloads (hex)
EXPO_PUBLIC_PAYLOAD_ENC_KEY=your-256-bit-hex-encryption-key-for-production-use-change-me
